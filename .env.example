# Local development requires no credentials. Node 24+ is required.
PROOFLANE_MODE=local
PORT=3000
CHAIN_PORT=8545
DATA_DIR=./data
# Public hosting: set these in Vercel's Production environment settings.
# PROOFLANE_MODE=base-sepolia
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
# RPC_URL=https://sepolia.base.org
# CONTRACT_ADDRESS=0x...
# DEPLOYMENT_BLOCK=...
# OWNER_PRIVATE_KEY=... fresh testnet-only owner; never an Anvil key
# AGENT_PRIVATE_KEY=... separate fresh testnet-only signer
# SESSION_SECRET=... 256-bit random secret encoded as base64 (44 characters)
# CONFIRMATIONS=3
# PUBLIC_ORIGIN=https://YOUR-ASSIGNED-PRODUCTION-DOMAIN.vercel.app
# Vercel's VERCEL_PROJECT_PRODUCTION_URL supplies the default HTTPS origin.
# Standalone Render deployments may use RENDER_EXTERNAL_URL instead.
# Public runtime uses the existing contract and never deploys on startup.
