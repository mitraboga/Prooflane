{
  "name": "prooflane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verifiable, policy-bound execution receipts for agent tools on Ethereum.",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "compile": "node scripts/compile.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node examples/agent.mjs",
    "verify": "node scripts/verify.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "lab:bitcoin": "node labs/bitcoin.mjs",
    "deploy:testnet": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "solc": "0.8.28"
  },
  "optionalDependencies": {
    "@foundry-rs/anvil-win32-amd64": "1.7.1",
    "@foundry-rs/anvil-linux-amd64": "1.7.1",
    "@foundry-rs/anvil-linux-arm64": "1.7.1",
    "@foundry-rs/anvil-darwin-amd64": "1.7.1",
    "@foundry-rs/anvil-darwin-arm64": "1.7.1"
  },
  "overrides": { "tmp": "0.2.7" },
  "license": "MIT"
}
